{
  "manifest_version": 3,
  "name": "Nudge",
  "version": "7.7.0",
  "description": "Who tagged you on Trello, one at a time, sorted into what needs you \u2014 plus a weekly follow-up draft per card, a read of whatever Canopy page you are on, and answers about a client from the Gmail thread in front of you.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "sidePanel",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nudge \u2014 who tagged you, and who needs chasing",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://trello.com/*",
        "*://*.trello.com/*"
      ],
      "js": [
        "trello-watch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.canopytax.com/*",
        "*://*.getcanopy.com/*",
        "*://canopy.us/*"
      ],
      "js": [
        "canopy-watch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mail.google.com/*"
      ],
      "js": [
        "gmail-watch.js"
      ],
      "run_at": "document_idle"
    }
  ]
}