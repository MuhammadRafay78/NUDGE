PORT=3000

# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Any mailto: address or https: URL identifying you to push services.
VAPID_SUBJECT=mailto:you@example.com

# Optional — the extension already syncs a card's full Trello comment
# thread here itself, the moment someone opens that card in its own board
# (no setup needed for that). This is only a second path, for a card
# nobody's opened in the extension yet: it lets the shareable board link
# fetch its comment thread directly instead of falling back to the one
# snippet Nudge stored on it when it was filed. A READ-ONLY Trello token
# is enough (this server never posts anything). See README.md > "Trello
# comments on the shareable board" for how to generate these. Leave both
# blank to skip this — the board still shows whatever the extension has
# already synced, same as before this existed.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Optional — lets the shareable board's "Ask the board" chat answer
# questions grounded in this code's own cards. Get a free key at
# https://aistudio.google.com/apikey (this is the same kind of key the
# extension's Settings > Sort mentions already uses, just a separate one
# for this server since it can't read the extension's stored key). See
# README.md > "Ask the board" for details. Leave blank to skip this — the
# chat button just says it isn't set up yet.
GEMINI_API_KEY=
