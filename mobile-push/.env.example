PORT=3000

# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Any mailto: address or https: URL identifying you to push services.
VAPID_SUBJECT=mailto:you@example.com

# Optional — lets the shareable board link show a card's full Trello
# comment thread, not just the one snippet Nudge stored on it. A
# READ-ONLY Trello token is enough (this server never posts anything).
# See README.md > "Trello comments on the shareable board" for how to
# generate these. Leave both blank to skip this — the board just falls
# back to the stored snippet, same as before this existed.
TRELLO_API_KEY=
TRELLO_TOKEN=
